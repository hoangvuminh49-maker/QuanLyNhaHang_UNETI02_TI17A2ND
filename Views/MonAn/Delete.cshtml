@model MonAn
@{
    ViewData["Title"] = "Xóa món ăn";
}

<h2 class="mb-4 text-danger">Xóa món ăn</h2>
<p>Bạn có chắc chắn muốn xóa món ăn sau không?</p>
<dl class="row">
    <dt class="col-sm-3">Tên món</dt>
    <dd class="col-sm-9">@Model.TenMon</dd>
    <dt class="col-sm-3">Đơn giá</dt>
    <dd class="col-sm-9">@Model.DonGia.ToString("#,##0") đ</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.MaMon" method="post">
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
