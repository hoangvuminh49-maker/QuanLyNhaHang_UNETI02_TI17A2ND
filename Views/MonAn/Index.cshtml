@model List<MonAn>
@{
    ViewData["Title"] = "Quản lý món ăn";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý món ăn</h2>
    <a asp-action="Create" class="btn btn-success">+ Thêm món ăn</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Tên món</th>
            <th>Loại món</th>
            <th>Đơn giá</th>
            <th>Trạng thái</th>
            <th style="width:280px">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mon in Model)
        {
            <tr>
                <td>@mon.TenMon</td>
                <td>@mon.LoaiMon</td>
                <td>@mon.DonGia.ToString("#,##0") đ</td>
                <td>
                    @if (mon.TrangThai)
                    {
                        <span class="badge bg-success">Đang phục vụ</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Ngừng phục vụ</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@mon.MaMon" class="btn btn-sm btn-info">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@mon.MaMon" class="btn btn-sm btn-warning">Sửa</a>
                    <form asp-action="CapNhatTrangThai" asp-route-id="@mon.MaMon" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-secondary">Đổi trạng thái</button>
                    </form>
                    <a asp-action="Delete" asp-route-id="@mon.MaMon" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
