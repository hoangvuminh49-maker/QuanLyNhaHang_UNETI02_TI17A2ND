@model MonAn
@{
    ViewData["Title"] = "Chi tiết món ăn";
}

<h2 class="mb-4">Chi tiết món ăn</h2>
<dl class="row">
    <dt class="col-sm-3">Tên món</dt>
    <dd class="col-sm-9">@Model.TenMon</dd>
    <dt class="col-sm-3">Loại món</dt>
    <dd class="col-sm-9">@Model.LoaiMon</dd>
    <dt class="col-sm-3">Đơn giá</dt>
    <dd class="col-sm-9">@Model.DonGia.ToString("#,##0") đ</dd>
    <dt class="col-sm-3">Mô tả</dt>
    <dd class="col-sm-9">@Model.MoTa</dd>
    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">@(Model.TrangThai ? "Đang phục vụ" : "Ngừng phục vụ")</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.MaMon" class="btn btn-warning">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
