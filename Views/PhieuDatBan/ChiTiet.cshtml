@model PhieuDatBan
@{
    ViewData["Title"] = "Chi tiết phiếu đặt bàn";
}

<h2 class="mb-4">Chi tiết phiếu đặt bàn #@Model.MaPhieu</h2>
<dl class="row">
    <dt class="col-sm-3">Khách hàng</dt>
    <dd class="col-sm-9">@Model.KhachHang?.HoTen</dd>
    <dt class="col-sm-3">Bàn</dt>
    <dd class="col-sm-9">@Model.BanAn?.TenBan (@Model.BanAn?.LoaiBan?.TenLoaiBan)</dd>
    <dt class="col-sm-3">Ngày đặt</dt>
    <dd class="col-sm-9">@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Ngày sử dụng</dt>
    <dd class="col-sm-9">@Model.NgaySuDung.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Giờ sử dụng</dt>
    <dd class="col-sm-9">@Model.GioBatDau.ToString("hh\\:mm") - @Model.GioKetThuc.ToString("hh\\:mm")</dd>
    <dt class="col-sm-3">Số người</dt>
    <dd class="col-sm-9">@Model.SoNguoi</dd>
    <dt class="col-sm-3">Ghi chú</dt>
    <dd class="col-sm-9">@Model.GhiChu</dd>
    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">@TrangThaiPhieu.Ten(Model.TrangThai)</dd>
</dl>
<a asp-action="LichSu" class="btn btn-secondary">Quay lại</a>
