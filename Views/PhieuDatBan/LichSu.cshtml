@model List<PhieuDatBan>
@{
    ViewData["Title"] = "Lịch sử đặt bàn";
}

<h2 class="mb-3">Lịch sử đặt bàn của tôi</h2>

<form method="get" asp-action="LichSu" class="row g-2 mb-3">
    <div class="col-md-3">
        <select name="trangThai" class="form-select" onchange="this.form.submit()">
            <option value="">-- Tất cả trạng thái --</option>
            <option value="ChoXacNhan" selected="@((ViewBag.TrangThai == "ChoXacNhan") ? "selected" : null)">Chờ xác nhận</option>
            <option value="DaXacNhan" selected="@((ViewBag.TrangThai == "DaXacNhan") ? "selected" : null)">Đã xác nhận</option>
            <option value="DaSuDung" selected="@((ViewBag.TrangThai == "DaSuDung") ? "selected" : null)">Đã sử dụng</option>
            <option value="DaHuy" selected="@((ViewBag.TrangThai == "DaHuy") ? "selected" : null)">Đã hủy</option>
        </select>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Mã phiếu</th>
            <th>Bàn</th>
            <th>Ngày sử dụng</th>
            <th>Giờ</th>
            <th>Số người</th>
            <th>Trạng thái</th>
            <th>Chi tiết</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.MaPhieu</td>
                <td>@p.BanAn?.TenBan (@p.BanAn?.LoaiBan?.TenLoaiBan)</td>
                <td>@p.NgaySuDung.ToString("dd/MM/yyyy")</td>
                <td>@p.GioBatDau.ToString("hh\\:mm") - @p.GioKetThuc.ToString("hh\\:mm")</td>
                <td>@p.SoNguoi</td>
                <td>@TrangThaiPhieu.Ten(p.TrangThai)</td>
                <td><a asp-action="ChiTiet" asp-route-id="@p.MaPhieu" class="btn btn-sm btn-info">Xem</a></td>
            </tr>
        }
    </tbody>
</table>
