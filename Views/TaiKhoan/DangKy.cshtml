@model DangKyViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Đăng ký tài khoản khách hàng</h2>
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="DangKy" method="post">
            <div class="mb-3">
                <label asp-for="HoTen" class="form-label"></label>
                <input asp-for="HoTen" class="form-control" />
                <span asp-validation-for="HoTen" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label"></label>
                <input asp-for="TenDangNhap" class="form-control" />
                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MatKhau" class="form-label"></label>
                    <input asp-for="MatKhau" type="password" class="form-control" />
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="XacNhanMatKhau" class="form-label"></label>
                    <input asp-for="XacNhanMatKhau" type="password" class="form-control" />
                    <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SoDienThoai" class="form-label"></label>
                <input asp-for="SoDienThoai" class="form-control" />
                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Đăng ký</button>
        </form>
        <p class="mt-3">Đã có tài khoản? <a asp-action="DangNhap">Đăng nhập</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
