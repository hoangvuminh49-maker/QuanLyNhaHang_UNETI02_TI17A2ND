@model List<LoaiBan>
@{
    ViewData["Title"] = "Quản lý loại bàn";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý loại bàn</h2>
    <a asp-action="Create" class="btn btn-success">+ Thêm loại bàn</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Tên loại bàn</th>
            <th>Mô tả</th>
            <th>Trạng thái</th>
            <th style="width:260px">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @{ int stt = 1; }
        @foreach (var lb in Model)
        {
            <tr>
                <td>@(stt++)</td>
                <td>@lb.TenLoaiBan</td>
                <td>@lb.MoTa</td>
                <td>
                    @if (lb.TrangThai)
                    {
                        <span class="badge bg-success badge-trangthai">Đang sử dụng</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary badge-trangthai">Ngừng sử dụng</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@lb.MaLoaiBan" class="btn btn-sm btn-info">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@lb.MaLoaiBan" class="btn btn-sm btn-warning">Sửa</a>
                    <form asp-action="CapNhatTrangThai" asp-route-id="@lb.MaLoaiBan" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-secondary">Đổi trạng thái</button>
                    </form>
                    <a asp-action="Delete" asp-route-id="@lb.MaLoaiBan" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
