@model LoaiBan
@{
    ViewData["Title"] = "Sửa loại bàn";
}

<div class="form-card">
    <h2>Sửa loại bàn</h2>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="MaLoaiBan" />
        <div class="form-group">
            <label asp-for="TenLoaiBan"></label>
            <input asp-for="TenLoaiBan" class="form-control" />
            <span asp-validation-for="TenLoaiBan" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="MoTa"></label>
            <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
            <span asp-validation-for="MoTa" class="text-danger"></span>
        </div>
        <div class="form-group form-check">
            <input asp-for="TrangThai" class="form-check-input" />
            <label asp-for="TrangThai" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
