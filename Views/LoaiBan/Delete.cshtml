@model LoaiBan
@{
    ViewData["Title"] = "Xóa loại bàn";
}

<h2 class="mb-4 text-danger">Xóa loại bàn</h2>
<p>Bạn có chắc chắn muốn xóa loại bàn sau không?</p>
<dl class="row">
    <dt class="col-sm-3">Tên loại bàn</dt>
    <dd class="col-sm-9">@Model.TenLoaiBan</dd>
    <dt class="col-sm-3">Mô tả</dt>
    <dd class="col-sm-9">@Model.MoTa</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.MaLoaiBan" method="post">
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
