@{
    var vaiTro = Context.Session.GetString("VaiTro");
    var hoTen = Context.Session.GetString("HoTen");
    var daDangNhap = Context.Session.GetInt32("MaTaiKhoan") != null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý nhà hàng</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">🍽️ Quản lý nhà hàng</a>
            <ul class="navbar-menu">
                @if (daDangNhap)
                {
                    @if (vaiTro == "Admin")
                    {
                        <li><a asp-controller="LoaiBan" asp-action="Index">Loại bàn</a></li>
                        <li><a asp-controller="TaiKhoan" asp-action="Index">Tài khoản</a></li>
                    }
                    <li class="navbar-user">Xin chào, <strong>@hoTen</strong> (@vaiTro)</li>
                    <li><a asp-controller="TaiKhoan" asp-action="DangXuat">Đăng xuất</a></li>
                }
                else
                {
                    <li><a asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a></li>
                }
            </ul>
        </nav>
    </header>

    <main class="container">
        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-success">@TempData["ThongBao"]</div>
        }
        @if (TempData["Loi"] != null)
        {
            <div class="alert alert-danger">@TempData["Loi"]</div>
        }

        @RenderBody()
    </main>

    <footer class="footer">
        <p>&copy; @DateTime.Now.Year - Đề tài 07: Quản lý nhà hàng và đặt bàn - ASP.NET Core 10 MVC</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
