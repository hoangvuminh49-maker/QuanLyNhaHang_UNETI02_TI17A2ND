<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý nhà hàng và đặt bàn</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var vaiTro = Context.Session.GetString(SessionKeys.VaiTro);
        var hoTen = Context.Session.GetString(SessionKeys.HoTen);
        var daDangNhap = Context.Session.GetInt32(SessionKeys.MaTaiKhoan) != null;
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🍽️ Nhà Hàng UNETI</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="MonAn" asp-action="ThucDon">Thực đơn</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="BanAn" asp-action="DanhSach">Danh sách bàn</a></li>

                        @if (daDangNhap && vaiTro == VaiTro.KhachHang)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="PhieuDatBan" asp-action="DatBan">Đặt bàn</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="PhieuDatBan" asp-action="LichSu">Phiếu của tôi</a></li>
                        }

                        @if (daDangNhap && vaiTro == VaiTro.Admin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Quản trị</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="LoaiBan" asp-action="Index">Loại bàn</a></li>
                                    <li><a class="dropdown-item" asp-controller="BanAn" asp-action="Index">Bàn ăn</a></li>
                                    <li><a class="dropdown-item" asp-controller="MonAn" asp-action="Index">Món ăn</a></li>
                                    <li><a class="dropdown-item" asp-controller="KhachHang" asp-action="Index">Khách hàng</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (daDangNhap)
                        {
                            @if (vaiTro == VaiTro.KhachHang)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="ThongTinCaNhan">Xin chào, @hoTen</a></li>
                            }
                            else
                            {
                                <li class="nav-item"><span class="nav-link">Xin chào, @hoTen (Admin)</span></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="DangXuat">Đăng xuất</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["ThongBao"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Loi"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Loi"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3 bg-light">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - Bài tập lớn Đề tài 07: Quản lý nhà hàng và đặt bàn - Nhóm UNETI02 - Lớp TI17A2ND
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
