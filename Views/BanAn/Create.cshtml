@model BanAn
@{
    ViewData["Title"] = "Thêm bàn ăn";
}

<h2 class="mb-4">Thêm bàn ăn</h2>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Create" method="post">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="TenBan" class="form-label"></label>
            <input asp-for="TenBan" class="form-control" />
            <span asp-validation-for="TenBan" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="MaLoaiBan" class="form-label"></label>
            <select asp-for="MaLoaiBan" class="form-select" asp-items="ViewBag.DanhSachLoaiBan"></select>
            <span asp-validation-for="MaLoaiBan" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="SoChoNgoi" class="form-label"></label>
            <input asp-for="SoChoNgoi" type="number" min="1" class="form-control" />
            <span asp-validation-for="SoChoNgoi" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ViTri" class="form-label"></label>
            <input asp-for="ViTri" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="MoTa" class="form-label"></label>
        <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="TrangThai" class="form-label"></label>
        <select asp-for="TrangThai" class="form-select">
            <option value="SanSang">Sẵn sàng</option>
            <option value="DangSuDung">Đang sử dụng</option>
            <option value="TamNgung">Tạm ngừng phục vụ</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
